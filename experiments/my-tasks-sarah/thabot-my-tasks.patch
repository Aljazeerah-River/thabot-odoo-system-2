+"""Local demo «مهامي» directory — session-scoped, not Odoo-backed yet.
+
+Employee identity and company come only from the verified chat session.
+Assignee filtering uses the fixed demo employee id mapped from that session.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping
+
+from fastapi import HTTPException
+
+from app.core.identity import ChatIdentity
+
+# Fixed demo employee for سارة (خبزي الخالي). Display name is presentation-only.
+SARAH_EMPLOYEE_ID = "emp_sarah_khubzi_001"
+SARAH_DISPLAY_NAME = "سارة"
+SARAH_USER_ID = "sarah_khubzi"
+KHUBZI_COMPANY_ID = "khubzi"
+KHUBZI_COMPANY_LABEL = "خبزي الخالي"
+
+# Second same-company employee with ordinary employee role (no elevated access).
+OMAR_EMPLOYEE_ID = "emp_omar_khubzi_002"
+OMAR_DISPLAY_NAME = "عمر"
+OMAR_USER_ID = "omar_khubzi"
+
+# Isolation peer: مصنع سعودي جلوتين فري / جي إف (register code ``gf``).
+GF_COMPANY_ID = "gf"
+GF_COMPANY_LABEL = "مصنع سعودي جلوتين فري"
+GF_EMPLOYEE_ID = "emp_nouf_gf_001"
+GF_DISPLAY_NAME = "نوف"
+GF_USER_ID = "nouf_gf"
+
+SARAH_TASK_ID = "task_m001"
+SARAH_TASK_TITLE = "إعداد جدول إنتاج الأسبوع"
+SARAH_TASK_DUE = "2026-11-19"
+SARAH_TASK_REF = "M-001 / D-01"
+
+
+@dataclass(frozen=True)
+class DemoEmployee:
+    employee_id: str
+    display_name: str
+    user_id: str
+    company_id: str
+    company_label: str
+    role: str = "employee"
+
+
+@dataclass(frozen=True)
+class DemoTask:
+    task_id: str
+    title: str
+    due_date: str
+    decision_ref: str
+    assignee_employee_id: str
+    company_id: str
+
+
+_EMPLOYEES: Mapping[tuple[str, str], DemoEmployee] = {
+    (KHUBZI_COMPANY_ID, SARAH_USER_ID): DemoEmployee(
+        SARAH_EMPLOYEE_ID, SARAH_DISPLAY_NAME, SARAH_USER_ID, KHUBZI_COMPANY_ID, KHUBZI_COMPANY_LABEL,
+    ),
+    (KHUBZI_COMPANY_ID, OMAR_USER_ID): DemoEmployee(
+        OMAR_EMPLOYEE_ID, OMAR_DISPLAY_NAME, OMAR_USER_ID, KHUBZI_COMPANY_ID, KHUBZI_COMPANY_LABEL,
+    ),
+    (GF_COMPANY_ID, GF_USER_ID): DemoEmployee(
+        GF_EMPLOYEE_ID, GF_DISPLAY_NAME, GF_USER_ID, GF_COMPANY_ID, GF_COMPANY_LABEL,
+    ),
+}
+
+_TASKS: tuple[DemoTask, ...] = (
+    DemoTask(
+        SARAH_TASK_ID,
+        SARAH_TASK_TITLE,
+        SARAH_TASK_DUE,
+        SARAH_TASK_REF,
+        SARAH_EMPLOYEE_ID,
+        KHUBZI_COMPANY_ID,
+    ),
+)
+
+
+def resolve_demo_employee(identity: ChatIdentity) -> DemoEmployee:
+    """Map the verified session to a fixed demo employee; never trust client body fields."""
+    if identity.role not in {"employee", "board", "admin"}:
+        raise HTTPException(403, "workforce_access_required")
+    employee = _EMPLOYEES.get((identity.company_id, identity.user_id))
+    if employee is None or employee.company_id != identity.company_id:
+        raise HTTPException(403, "employee_directory_miss")
+    return employee
+
+
+def _serialize(task: DemoTask, employee: DemoEmployee) -> dict:
+    return {
+        "task_id": task.task_id,
+        "title": task.title,
+        "due_date": task.due_date,
+        "decision_ref": task.decision_ref,
+        "assignee": {
+            "employee_id": employee.employee_id,
+            "display_name": employee.display_name,
+        },
+        "company": {
+            "company_id": employee.company_id,
+            "label": employee.company_label,
+        },
+    }
+
+
+def list_my_tasks(identity: ChatIdentity) -> dict:
+    employee = resolve_demo_employee(identity)
+    items = [
+        _serialize(task, employee)
+        for task in _TASKS
+        if task.company_id == employee.company_id and task.assignee_employee_id == employee.employee_id
+    ]
+    return {
+        "employee": {
+            "employee_id": employee.employee_id,
+            "display_name": employee.display_name,
+            "company_id": employee.company_id,
+            "company_label": employee.company_label,
+        },
+        "tasks": items,
+    }
+
+
+def get_my_task(identity: ChatIdentity, task_id: str) -> dict:
+    employee = resolve_demo_employee(identity)
+    for task in _TASKS:
+        if task.task_id != task_id:
+            continue
+        if task.company_id != employee.company_id or task.assignee_employee_id != employee.employee_id:
+            # Same-company peers and other tenants must not learn that the task exists.
+            raise HTTPException(404, "task_not_found")
+        return _serialize(task, employee)
+    raise HTTPException(404, "task_not_found")
