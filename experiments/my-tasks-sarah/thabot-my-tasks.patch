+import React from "react";
+import { StyleSheet, Text, View } from "react-native";
+import type { MyTask, MyTasksPayload } from "./api";
+import { styles as shared } from "./Workspace";
+
+function formatDueDate(iso: string): string {
+  // Keep the server date authoritative; present it in Arabic-friendly digits only.
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
+  if (!match) return iso;
+  const [, year, month, day] = match;
+  return `${day} / ${month} / ${year}`;
+}
+
+export function MyTasksPanel({ payload }: { payload: MyTasksPayload }) {
+  return (
+    <View style={shared.card} testID="my-tasks-panel">
+      <Text accessibilityRole="header" style={shared.heading}>مهامي</Text>
+      <Text style={shared.muted}>
+        {payload.employee.display_name} · {payload.employee.company_label}
+      </Text>
+      {payload.tasks.length === 0 ? (
+        <Text style={shared.text}>لا توجد مهام مسندة إلى حسابك حالياً.</Text>
+      ) : payload.tasks.map((task: MyTask) => (
+        <View key={task.task_id} style={styles.task} testID={`task-${task.task_id}`}>
+          <Text accessibilityRole="header" style={styles.taskTitle}>{task.title}</Text>
+          <Text style={shared.text}>الموعد: {formatDueDate(task.due_date)}</Text>
+          <Text style={styles.ref}>مرجع القرار: {task.decision_ref}</Text>
+        </View>
+      ))}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  task: {
+    gap: 8,
+    paddingTop: 8,
+    borderTopWidth: 1,
+    borderTopColor: "#dae5de",
+  },
+  taskTitle: {
+    fontSize: 18,
+    fontWeight: "700",
+    color: "#173d30",
+    textAlign: "right",
+    writingDirection: "rtl",
+  },
+  ref: {
+    fontSize: 15,
+    color: "#176955",
+    fontWeight: "600",
+    textAlign: "right",
+    writingDirection: "rtl",
+  },
+});
