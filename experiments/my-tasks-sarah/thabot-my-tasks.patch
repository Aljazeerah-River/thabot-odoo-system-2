+#!/usr/bin/env bash
+# Start the Thabot API on loopback with the local «مهامي» JWT keys.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+python3 scripts/mint_local_mobile_session.py --who sarah --minutes 120 --write-env work/local-mobile.env >/tmp/thabot-local-session.json
+export APP_ENV=development
+export JWT_ISSUER=https://identity.local.thabot.test
+export JWT_AUDIENCE=thabot-mobile-local
+export JWT_PUBLIC_KEY="$(cat work/local-mobile-keys/jwt_public.pem)"
+export PYTHONPATH=api
+exec python3 -m uvicorn app.main:app --host 127.0.0.1 --port "${PORT:-8001}"
