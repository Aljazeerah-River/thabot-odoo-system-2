+import React from "react";
+import { render, screen } from "@testing-library/react-native";
+import { MyTasksPanel } from "../MyTasks";
+
+test("renders Arabic مهامي task title due date and decision reference", () => {
+  render(
+    <MyTasksPanel
+      payload={{
+        employee: {
+          employee_id: "emp_sarah_khubzi_001",
+          display_name: "سارة",
+          company_id: "khubzi",
+          company_label: "خبزي الخالي",
+        },
+        tasks: [{
+          task_id: "task_m001",
+          title: "إعداد جدول إنتاج الأسبوع",
+          due_date: "2026-11-19",
+          decision_ref: "M-001 / D-01",
+          assignee: { employee_id: "emp_sarah_khubzi_001", display_name: "سارة" },
+          company: { company_id: "khubzi", label: "خبزي الخالي" },
+        }],
+      }}
+    />,
+  );
+  expect(screen.getByText("مهامي")).toBeTruthy();
+  expect(screen.getByText("إعداد جدول إنتاج الأسبوع")).toBeTruthy();
