@@ -0,0 +1,117 @@
+"""«مهامي» local demo — four baseline cases plus same-company peer isolation."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+from fastapi import FastAPI, HTTPException
+
+from app import mobile
+from app.core import my_tasks as my_tasks_mod
+from app.core.public_assistant import PilotRateLimiter
+from tests.test_mobile_http import invoke
+
+
+@pytest.fixture
+def api(monkeypatch):
+    monkeypatch.setenv("APP_ENV", "development")
+    monkeypatch.delenv("THABOT_PUBLIC_CHAT_ENABLED", raising=False)
+    monkeypatch.setattr(mobile, "limiter", PilotRateLimiter())
+
+    def identity(request):
+        token = request.headers.get("authorization", "")
+        directory = {
+            "Bearer fixture_sarah_khubzi": SimpleNamespace(
+                user_id=my_tasks_mod.SARAH_USER_ID, role="employee", company_id=my_tasks_mod.KHUBZI_COMPANY_ID,
+            ),
+            "Bearer fixture_omar_khubzi": SimpleNamespace(
+                user_id=my_tasks_mod.OMAR_USER_ID, role="employee", company_id=my_tasks_mod.KHUBZI_COMPANY_ID,
+            ),
+            "Bearer fixture_nouf_gf": SimpleNamespace(
+                user_id=my_tasks_mod.GF_USER_ID, role="employee", company_id=my_tasks_mod.GF_COMPANY_ID,
+            ),
+            "Bearer fixture_board_a": SimpleNamespace(
+                user_id="fixture_user", role="board", company_id="company_a",
+            ),
+        }
+        if token in directory:
+            return directory[token]
+        raise HTTPException(401, "invalid_token")
+
+    monkeypatch.setattr(mobile, "_resolve", identity)
+    app = FastAPI()
+    app.include_router(mobile.router)
+    return app
+
+
+def auth(who: str) -> dict:
+    return {"authorization": f"Bearer fixture_{who}", "x-role": "admin", "x-company-id": "forged"}
+
+
+# --- Four baseline experiment tests -------------------------------------------------
+
+def test_1_sarah_sees_production_schedule_task(api):
+    result = invoke(api, "/v1/mobile/tasks", headers=auth("sarah_khubzi"))
+    assert result.status == 200
+    assert result.headers["cache-control"] == "no-store"
+    assert result.state["company_id"] == my_tasks_mod.KHUBZI_COMPANY_ID
+    body = result.body
+    assert body["employee"]["employee_id"] == my_tasks_mod.SARAH_EMPLOYEE_ID
+    assert body["employee"]["display_name"] == "سارة"
+    assert body["employee"]["company_label"] == "خبزي الخالي"
+    assert len(body["tasks"]) == 1
+    task = body["tasks"][0]
+    assert task["title"] == "إعداد جدول إنتاج الأسبوع"
+    assert task["due_date"] == "2026-11-19"
+    assert task["decision_ref"] == "M-001 / D-01"
+    assert task["assignee"]["employee_id"] == my_tasks_mod.SARAH_EMPLOYEE_ID
+    # Client-forged company/role headers must not change session binding.
+    assert task["company"]["company_id"] == my_tasks_mod.KHUBZI_COMPANY_ID
+
+
+def test_2_tasks_require_authentication(api):
+    result = invoke(api, "/v1/mobile/tasks", headers={"x-role": "admin", "x-company-id": my_tasks_mod.KHUBZI_COMPANY_ID})
+    assert result.status == 401
+    assert result.body["detail"] == "authentication_required"
+    assert result.state["audit_context"]["user_id"] == "anonymous"
+
+
+def test_3_saudi_gf_employee_isolated_from_sarah_tasks(api):
+    listed = invoke(api, "/v1/mobile/tasks", headers=auth("nouf_gf"))
+    assert listed.status == 200
+    assert listed.state["company_id"] == my_tasks_mod.GF_COMPANY_ID
+    assert listed.body["employee"]["company_label"] == "مصنع سعودي جلوتين فري"
+    assert listed.body["tasks"] == []
+    detail = invoke(api, f"/v1/mobile/tasks/{my_tasks_mod.SARAH_TASK_ID}", headers=auth("nouf_gf"))
+    assert detail.status == 404
+    assert detail.body == {"detail": "task_not_found"}
+
+
+def test_4_sarah_can_open_task_by_decision_id(api):
+    result = invoke(api, f"/v1/mobile/tasks/{my_tasks_mod.SARAH_TASK_ID}", headers=auth("sarah_khubzi"))
+    assert result.status == 200
+    assert result.body["title"] == "إعداد جدول إنتاج الأسبوع"
+    assert result.body["due_date"] == "2026-11-19"
+    assert result.body["decision_ref"] == "M-001 / D-01"
+    assert result.body["assignee"]["display_name"] == "سارة"
+
+
+# --- Added: same-company peer with ordinary employee permissions --------------------
+
+def test_5_second_khubzi_employee_cannot_list_or_open_sarah_task(api):
+    listed = invoke(api, "/v1/mobile/tasks", headers=auth("omar_khubzi"))
+    assert listed.status == 200
+    assert listed.body["employee"]["employee_id"] == my_tasks_mod.OMAR_EMPLOYEE_ID
+    assert listed.body["employee"]["display_name"] == "عمر"
+    assert listed.body["employee"]["company_id"] == my_tasks_mod.KHUBZI_COMPANY_ID
+    assert listed.body["tasks"] == []
+    assert all(task.get("task_id") != my_tasks_mod.SARAH_TASK_ID for task in listed.body["tasks"])
+    detail = invoke(api, f"/v1/mobile/tasks/{my_tasks_mod.SARAH_TASK_ID}", headers=auth("omar_khubzi"))
+    assert detail.status == 404
+    assert detail.body == {"detail": "task_not_found"}
+
+
+def test_bootstrap_advertises_local_my_tasks_capability(api):
+    result = invoke(api, headers=auth("sarah_khubzi"))
+    assert result.status == 200
+    assert result.body["capabilities"]["my_tasks"] == "local_demo_directory"
