+/**
+ * Local-only harness for the «مهامي» experiment.
+ * Not the production entry. Requires a short-lived token minted by
+ * scripts/mint_local_mobile_session.py and a loopback API origin.
+ */
+import { ThabotApp } from "./App";
+import type { Session } from "./api";
+
+const origin = (process.env.EXPO_PUBLIC_THABOT_API_ORIGIN || "http://127.0.0.1:8001").trim();
+const token = (process.env.EXPO_PUBLIC_THABOT_LOCAL_ACCESS_TOKEN || "").trim();
+const expiresAt = Number(process.env.EXPO_PUBLIC_THABOT_LOCAL_EXPIRES_AT || "0");
+
+const session: Session | null =
+  token && Number.isFinite(expiresAt) && expiresAt > Date.now()
+    ? { accessToken: token, expiresAt }
+    : null;
+
+export default function LocalTestApp() {
+  return <ThabotApp session={session} apiOrigin={origin} onSignOut={() => {}} />;
+}
