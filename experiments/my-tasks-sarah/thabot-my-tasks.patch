@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+"""Mint a short-lived local JWT for the «مهامي» Sarah session (loopback only)."""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric import rsa
+import jwt
+
+ROOT = Path(__file__).resolve().parents[1]
+KEYS = ROOT / "work" / "local-mobile-keys"
+PRIVATE = KEYS / "jwt_private.pem"
+PUBLIC = KEYS / "jwt_public.pem"
+
+ISSUER = "https://identity.local.thabot.test"
+AUDIENCE = "thabot-mobile-local"
+
+
+def ensure_keys() -> tuple[str, str]:
+    KEYS.mkdir(parents=True, exist_ok=True)
+    if not PRIVATE.exists() or not PUBLIC.exists():
+        key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+        PRIVATE.write_bytes(
+            key.private_bytes(
+                serialization.Encoding.PEM,
+                serialization.PrivateFormat.PKCS8,
+                serialization.NoEncryption(),
+            )
+        )
+        PUBLIC.write_bytes(
+            key.public_key().public_bytes(
+                serialization.Encoding.PEM,
+                serialization.PublicFormat.SubjectPublicKeyInfo,
+            )
+        )
+    return PRIVATE.read_text(), PUBLIC.read_text()
+
+
+def mint(who: str, minutes: int) -> dict:
+    private_pem, public_pem = ensure_keys()
+    directory = {
+        "sarah": {"sub": "sarah_khubzi", "role": "employee", "company_id": "khubzi"},
+        "omar": {"sub": "omar_khubzi", "role": "employee", "company_id": "khubzi"},
+        "nouf": {"sub": "nouf_gf", "role": "employee", "company_id": "gf"},
+    }
+    if who not in directory:
+        raise SystemExit(f"unknown who={who}; expected one of {sorted(directory)}")
+    now = datetime.now(timezone.utc)
+    claims = {
+        **directory[who],
+        "iss": ISSUER,
+        "aud": AUDIENCE,
+        "iat": now,
+        "exp": now + timedelta(minutes=minutes),
+    }
+    token = jwt.encode(claims, private_pem, algorithm="RS256")
+    expires_at_ms = int((now + timedelta(minutes=minutes)).timestamp() * 1000)
+    return {
+        "accessToken": token,
+        "expiresAt": expires_at_ms,
+        "claims": {k: (v.isoformat() if isinstance(v, datetime) else v) for k, v in claims.items()},
+        "env": {
+            "APP_ENV": "development",
+            "JWT_ISSUER": ISSUER,
+            "JWT_AUDIENCE": AUDIENCE,
+            "JWT_PUBLIC_KEY": public_pem,
+            "EXPO_PUBLIC_THABOT_LOCAL_ACCESS_TOKEN": token,
+            "EXPO_PUBLIC_THABOT_LOCAL_EXPIRES_AT": str(expires_at_ms),
+            "EXPO_PUBLIC_THABOT_API_ORIGIN": os.environ.get("EXPO_PUBLIC_THABOT_API_ORIGIN", "http://127.0.0.1:8001"),
+        },
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--who", default="sarah", choices=["sarah", "omar", "nouf"])
+    parser.add_argument("--minutes", type=int, default=60)
+    parser.add_argument("--write-env", type=Path, default=None)
+    args = parser.parse_args()
+    payload = mint(args.who, args.minutes)
+    if args.write_env:
+        lines = [f"{key}={json.dumps(value) if isinstance(value, str) and chr(10) in value else value}"
+                 for key, value in payload["env"].items()]
+        # Multiline PEM needs special handling for dotenv consumers: write a companion public key file.
+        public_path = KEYS / "jwt_public.pem"
+        env_lines = [
+            f"APP_ENV=development",
+            f"JWT_ISSUER={ISSUER}",
+            f"JWT_AUDIENCE={AUDIENCE}",
+            f"JWT_PUBLIC_KEY_FILE={public_path}",
+            f"EXPO_PUBLIC_THABOT_LOCAL_ACCESS_TOKEN={payload['accessToken']}",
+            f"EXPO_PUBLIC_THABOT_LOCAL_EXPIRES_AT={payload['expiresAt']}",
+            f"EXPO_PUBLIC_THABOT_API_ORIGIN={payload['env']['EXPO_PUBLIC_THABOT_API_ORIGIN']}",
+        ]
+        args.write_env.write_text("\n".join(env_lines) + "\n")
+    print(json.dumps({"accessToken": payload["accessToken"], "expiresAt": payload["expiresAt"], "claims": payload["claims"]}, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
